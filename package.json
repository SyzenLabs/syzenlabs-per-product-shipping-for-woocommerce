{
	"name": "syzenlabs-per-product-shipping",
	"version": "1.0.0",
	"license": "GPL-3.0-only",
	"main": "src/index.js",
	"prettier": "@wordpress/prettier-config",
	"scripts": {
		"setup": "npm ci --ignore-scripts",
		"start": "wp-scripts start",
		"dev": "wp-scripts start",
		"ver-update": "node ./scripts/ver-updater.js",
		"build": "wp-scripts build && gulp package",
		"release": "node -e \"throw new Error('Release publishing is disabled until a Syzenlabs destination is configured.')\"",
		"release:ci": "node -e \"throw new Error('Release publishing is disabled until a Syzenlabs destination is configured.')\"",
		"build:webpack": "wp-scripts build",
		"package": "gulp package",
		"i18n": "npm run i18n:make-pot && npm run i18n:make-mo && npm run i18n:make-json",
		"i18n:make-pot": "php -d memory_limit=2G wp-cli.phar i18n make-pot . languages/syzenlabs-per-product-shipping.pot --allow-root --slug=syzenlabs-per-product-shipping --exclude=build,node_modules,vendor,vendor_prefixed,tests,docs",
		"i18n:make-mo": "php wp-cli.phar i18n make-mo languages --allow-root",
		"i18n:make-json": "php wp-cli.phar i18n make-json languages --allow-root",
		"format": "npx prettier ./src --write",
		"lint": "eslint ./src",
		"test:php": "php tests/admin-assets.php",
		"test:unit": "wp-scripts test-unit-js --runInBand --watch=false",
		"test:admin": "playwright test"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@playwright/test": "1.58.2",
		"@wordpress/eslint-plugin": "^24.0.0",
		"@wordpress/prettier-config": "^4.46.0",
		"@wordpress/scripts": "^31.3.0",
		"autoprefixer": "10.6.2",
		"cssnano": "7.1.9",
		"del": "^8.0.1",
		"eslint": "^8.56.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-you-might-not-need-an-effect": "^0.8.5",
		"gulp": "^5.0.1",
		"gulp-zip": "^6.1.0",
		"prettier": "npm:wp-prettier@^3.0.3",
		"tailwindcss": "3.4.19"
	},
	"dependencies": {
		"@radix-ui/react-alert-dialog": "1.2.1",
		"@radix-ui/react-checkbox": "1.4.1",
		"@radix-ui/react-collapsible": "1.2.1",
		"@radix-ui/react-dialog": "1.3.1",
		"@radix-ui/react-dropdown-menu": "2.2.1",
		"@radix-ui/react-select": "2.4.1",
		"@radix-ui/react-slot": "1.5.0",
		"@radix-ui/react-switch": "1.4.1",
		"@wordpress/api-fetch": "^7.35.0",
		"@wordpress/element": "^6.38.0",
		"@wordpress/i18n": "^6.11.0",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"lucide-react": "1.70.0",
		"motion": "12.43.0",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"react-router-dom": "7.18.5",
		"tailwind-merge": "2.6.1"
	},
	"engines": {
		"node": ">=20",
		"npm": ">=10"
	}
}
